units lj
atom_style bond
boundary p p p
special_bonds fene
atom_modify map yes
variable EQUIL_STEPS index 100000
variable TRAJ_EVERY index 10000
variable NETWORK_EVERY index 10000
variable block equal ${NETWORK_EVERY}
read_data ${F}.lammpsdat
group stickers type 2
group stars type 1 2
bond_style fene
bond_coeff 1 30 1.5 1 1
variable rwca equal 2.0^(1.0/6.0)
pair_style hybrid/overlay lj/cut ${rwca} associating
pair_coeff * * lj/cut 1 1 ${rwca}
pair_coeff * * associating 30 1.5 8
neighbor 0.6 bin
neigh_modify every 1 delay 1 check yes
comm_modify vel yes
timestep 0.01
velocity all create 1.0 4839876 mom yes rot yes dist gaussian
fix integrate all nve
fix thermostat all langevin 1 1 2 48279 zero yes
fix kinetics stickers associating/kinetics 100 492845 10 4 1 ${rwca}
reset_atoms image stars
dump traj stars custom ${TRAJ_EVERY} ${F}.r1b1.equil.lammpstrj id mol type xu yu zu
dump_modify traj sort id
variable t equal temp
variable ep equal pe
thermo 1000
thermo_style custom step temp pe f_kinetics[1] f_kinetics[2] f_kinetics[3]
thermo_modify norm no
fix diag all ave/time 1000 1 1000 v_t v_ep f_kinetics[1] f_kinetics[2] f_kinetics[3] file ${F}.r1b1.equil.diagnostics mode scalar ave one
variable nblock equal v_EQUIL_STEPS/v_block
variable i loop ${nblock}
label loop
run ${block}
variable s equal step
write_associating_network ${F}.r1b1.equil.network.${s}.dat fix kinetics
next i
jump SELF loop
write_restart ${F}.r1b1.equil.restart
