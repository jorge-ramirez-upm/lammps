# Nonassociating full-system control for the Javier star model.
# This input intentionally contains no transient association style or fix.
units lj
atom_style bond
boundary p p p
special_bonds fene
atom_modify map yes
read_data ${DATA}
reset_timestep 0
group stars type 1 2
bond_style fene
bond_coeff 1 30.0 1.5 1.0 1.0
variable rwca equal 2.0^(1.0/6.0)
pair_style lj/cut ${rwca}
pair_coeff * * 1.0 1.0 ${rwca}
neighbor 0.6 bin
neigh_modify every 1 delay 1 check yes
comm_modify vel yes
timestep 0.01
fix integrate all nve
fix thermostat all langevin 1.0 1.0 2.0 ${LANGEVIN_SEED} zero yes

# Corrected ordinary six-component pressure ordering: xx yy zz xy xz yz.
compute press all pressure thermo_temp
variable st equal step
variable pxx equal c_press[1]
variable pyy equal c_press[2]
variable pzz equal c_press[3]
variable pxy equal c_press[4]
variable pxz equal c_press[5]
variable pyz equal c_press[6]
variable nxy equal c_press[1]-c_press[2]
variable nxz equal c_press[1]-c_press[3]
variable nyz equal c_press[2]-c_press[3]
fix raw all print 1 "${st} ${pxx} ${pyy} ${pzz} ${pxy} ${pxz} ${pyz}" file ${OUT_PREFIX}.raw screen no title "# step Pxx Pyy Pzz Pxy Pxz Pyz"
if "${ONLINE} == 1" then "fix corr all ave/correlate/long 1 100000 v_pxy v_pxz v_pyz v_nxy v_nxz v_nyz type auto file ${OUT_PREFIX}.gt overwrite ncorr 40"

if "${TRAJ_GZ} == 1" then "dump starcoords stars custom/gz ${TRAJ_EVERY} ${OUT_PREFIX}.lammpstrj.gz id mol type xu yu zu" else "dump starcoords stars custom ${TRAJ_EVERY} ${OUT_PREFIX}.lammpstrj id mol type xu yu zu"
dump_modify starcoords sort id

variable t equal temp
variable ep equal pe
fix diagnostics all ave/time 1000 1 1000 v_t v_ep c_press[1] c_press[2] c_press[3] c_press[4] c_press[5] c_press[6] file ${OUT_PREFIX}.diagnostics mode scalar ave one format "%16.12g"
thermo 1000
thermo_style custom step temp pe etotal c_press[1] c_press[2] c_press[3] c_press[4] c_press[5] c_press[6]
thermo_modify norm no
run ${PROD_STEPS}
write_restart ${OUT_PREFIX}.restart
