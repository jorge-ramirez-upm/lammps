# R1-A fresh equilibrium stress-correlation prototype; start only from r1a.equil.restart.
units lj
atom_style bond
boundary p p p
special_bonds fene
atom_modify map yes
variable prodsteps equal ${PILOT_STEPS}
variable prodsteps equal 1000000
read_restart ${F}.r1a.equil_cont.restart
read_restart Stars_NA4N10C1000rho0.85rhopoly0.8.equilibrated.r1a.equil_cont.restart
