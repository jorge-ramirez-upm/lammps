group stickers type 2
4000 atoms in group stickers
bond_style fene
bond_coeff 1 30.0 1.5 1.0 1.0
variable rwca equal 2.0^(1.0/6.0)
pair_style hybrid/overlay lj/cut ${rwca} associating
pair_style hybrid/overlay lj/cut 1.12246204830937 associating
pair_coeff * * lj/cut 1.0 1.0 ${rwca}
pair_coeff * * lj/cut 1.0 1.0 1.12246204830937
pair_coeff * * associating 30.0 1.5 8.0
neighbor 0.6 bin
neigh_modify every 1 delay 1 check yes
comm_modify vel yes
timestep 0.01
fix integrate all nve
fix thermostat all langevin 1.0 1.0 2.0 48279 zero yes
fix kinetics stickers associating/kinetics 100 492845 10.0 4.0 1.0 ${rwca}
fix kinetics stickers associating/kinetics 100 492845 10.0 4.0 1.0 1.12246204830937
Resetting global fix info from restart file:
  fix style: associating/kinetics, fix ID: kinetics
Resetting peratom fix info from restart file:
  fix style: associating/kinetics, fix ID: kinetics
reset_timestep 0
# compute pressure ordering, verified in this tree: xx yy zz xy xz yz.
compute press all pressure thermo_temp
variable sxy equal c_press[4]
variable sxz equal c_press[5]
variable syz equal c_press[6]
variable nxy equal c_press[1]-c_press[2]
variable nxz equal c_press[1]-c_press[3]
variable nyz equal c_press[2]-c_press[3]
# Jorge's R1-A prototype cadence.  AUTO writes these six autocorrelations independently.
fix corr all ave/correlate/long 1 100000 v_sxy v_sxz v_syz v_nxy v_nxz v_nyz type auto file ${F}.gt overwrite ncorr 40
fix corr all ave/correlate/long 1 100000 v_sxy v_sxz v_syz v_nxy v_nxz v_nyz type auto file Stars_NA4N10C1000rho0.85rhopoly0.8.equilibrated.gt overwrite ncorr 40
variable t equal temp
variable ep equal pe
thermo 1000
thermo_style custom step temp pe etotal c_press[1] c_press[2] c_press[3] c_press[4] c_press[5] c_press[6] f_kinetics[1]
thermo_modify norm no
fix diagnostics all ave/time 1000 1 1000 v_t v_ep c_press[1] c_press[2] c_press[3] c_press[4] c_press[5] c_press[6] f_kinetics[1] file ${F}.r1a.stress.diagnostics mode scalar ave one format "%16.12g"
fix diagnostics all ave/time 1000 1 1000 v_t v_ep c_press[1] c_press[2] c_press[3] c_press[4] c_press[5] c_press[6] f_kinetics[1] file Stars_NA4N10C1000rho0.85rhopoly0.8.equilibrated.r1a.stress.diagnostics mode scalar ave one format "%16.12g"
run ${prodsteps}
run 1000000

