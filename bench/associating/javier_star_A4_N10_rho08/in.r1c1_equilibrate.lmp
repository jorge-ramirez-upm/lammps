# R1-C1 optional fresh equilibration from the original no-transient-bond data.
units lj
atom_style bond
boundary p p p
special_bonds fene
atom_modify map yes
read_data ${DATA}
group stickers type 2
group stars type 1 2
bond_style fene
bond_coeff 1 30.0 1.5 1.0 1.0
variable rwca equal 2.0^(1.0/6.0)
pair_style hybrid/overlay lj/cut ${rwca} associating
pair_coeff * * lj/cut 1.0 1.0 ${rwca}
pair_coeff * * associating 30.0 1.5 8.0
neighbor 0.6 bin
neigh_modify every 1 delay 1 check yes
comm_modify vel yes
timestep 0.01
velocity all create 1.0 ${VELOCITY_SEED} mom yes rot yes dist gaussian
fix integrate all nve
fix thermostat all langevin 1.0 1.0 2.0 ${LANGEVIN_SEED} zero yes
fix kinetics stickers associating/kinetics 100 ${KINETICS_SEED} 10.0 4.0 1.0 ${rwca}
reset_atoms image stars
variable t equal temp
variable ep equal pe
fix diagnostics all ave/time 1000 1 1000 v_t v_ep f_kinetics[1] f_kinetics[2] f_kinetics[3] file equil.diagnostics mode scalar ave one
thermo 1000
thermo_style custom step temp pe f_kinetics[1] f_kinetics[2] f_kinetics[3]
thermo_modify norm no
run ${EQUIL_STEPS}
write_restart equil.restart
