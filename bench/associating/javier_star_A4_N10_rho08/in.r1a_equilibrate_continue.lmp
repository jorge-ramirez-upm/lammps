# R1-A.1 continuation from the 200k network-equilibration restart.
# Invoke with -var F and -var CONT_STEPS (a multiple of 10000).
units lj
atom_style bond
boundary p p p
special_bonds fene
atom_modify map yes
variable contsteps equal ${CONT_STEPS}
variable TRAJ_EVERY index 10000
variable NETWORK_EVERY index 10000
variable block equal ${NETWORK_EVERY}
read_restart ${F}.r1a.equil.restart
group stickers type 2
group stars type 1 2
bond_style fene
bond_coeff 1 30.0 1.5 1.0 1.0
variable rwca equal 2.0^(1.0/6.0)
pair_style hybrid/overlay lj/cut ${rwca} associating
pair_coeff * * lj/cut 1.0 1.0 ${rwca}
pair_coeff * * associating 30.0 1.5 8.0
neighbor 0.6 bin
neigh_modify every 1 delay 1 check yes
comm_modify vel yes
timestep 0.01
fix integrate all nve
fix thermostat all langevin 1.0 1.0 2.0 48279 zero yes
# Reusing this fix ID restores its restart state, including transient partners.
fix kinetics stickers associating/kinetics 100 492845 10.0 4.0 1.0 ${rwca}
# Normalize bonded-star image flags for unwrapped-coordinate diagnostics only.
reset_atoms image stars
dump starcoords stars custom/gz ${TRAJ_EVERY} ${F}.r1a.cont.unwrapped.lammpstrj.gz id mol type xu yu zu
dump_modify starcoords sort id
variable t equal temp
variable ep equal pe
thermo 1000
thermo_style custom step temp pe etotal f_kinetics[1] f_kinetics[2] f_kinetics[3]
thermo_modify norm no
fix diagnostics all ave/time 1000 1 1000 v_t v_ep f_kinetics[1] f_kinetics[2] f_kinetics[3] file ${F}.r1a.cont.diagnostics mode scalar ave one format "%16.12g"
variable nblock equal v_contsteps/v_block
variable i loop ${nblock}
label continuation_loop
run ${block}
variable snap equal step
write_associating_network ${F}.r1a.cont.network.${snap}.dat fix kinetics
next i
jump SELF continuation_loop
write_restart ${F}.r1a.equil_cont.restart
